        </mxCell>
        <mxCell id="update_diff" value="更新差商表\(f[x_j] = \frac{f[x_{j+1}] - f[x_j]}{x_{j+1} - x_j}\)" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="520" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="next_k" value="\(k = k + 1\)" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
