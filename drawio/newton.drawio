        </mxCell>
        <mxCell id="calc_diff" value="计算一阶差商\(f[x_i] = \frac{y_i - f[x_{i-1}]}{x_i - x_{i-1}}\)" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="305" y="360" width="230" height="40" as="geometry" />
        </mxCell>
