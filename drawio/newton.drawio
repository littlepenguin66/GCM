          <mxGeometry x="300" y="120" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="init" value="初始化差商表\(f[x_0] = y_0\)" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
